{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zabbix Actions Problems API",
    "version": "7.0"
  },
  "items": [
    {
      "info": {
        "name": "Problems",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Problems",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/zabbix/api_jsonrpc.php/problem.get",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns active problems currently affecting monitored hosts."
        }
      ]
    }
  ],
  "bundled": true
}