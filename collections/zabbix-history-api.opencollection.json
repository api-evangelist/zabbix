{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zabbix Actions History API",
    "version": "7.0"
  },
  "items": [
    {
      "info": {
        "name": "History",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get History",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/zabbix/api_jsonrpc.php/history.get",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns historical monitoring data for items over a time range."
        }
      ]
    }
  ],
  "bundled": true
}